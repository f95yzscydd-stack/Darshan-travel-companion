{
  "name": "portugal-companion",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "generate:icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "predeploy": "expo export --platform web && node scripts/prepare-gh-pages.mjs",
    "deploy": "gh-pages --nojekyll -d dist"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "expo": "~56.0.0",
    "expo-blur": "~56.0.0",
    "expo-constants": "~56.0.0",
    "expo-font": "~56.0.0",
    "expo-haptics": "~56.0.0",
    "expo-linear-gradient": "~56.0.0",
    "expo-linking": "~56.0.0",
    "expo-router": "~56.2.11",
    "expo-splash-screen": "~56.0.0",
    "expo-sqlite": "~56.0.0",
    "expo-status-bar": "~56.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-reanimated": "~4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.85.3",
    "@types/react": "~19.2.0",
    "gh-pages": "^6.3.0",
    "typescript": "~5.9.2"
  }
}
